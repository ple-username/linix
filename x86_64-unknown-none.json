  "disable-redzone": true,
  "features": "-mmx,-sse,-sse2,-sse3,-ssse3,-sse4.1,-sse4.2,-3dnow,-3dnowa,-avx,-avx2,-avx512f,-avx512cd,-avx512er,-avx512pf,-avx512dq,-avx512bw,-avx512vl,-avx512ifma,-avx512vbmi",
  "panic-strategy": "abort",
